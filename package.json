{
  "name": "tyche",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.engine.json && tsc -p tsconfig.node.json",
    "test:e2e": "playwright test",
    "test:autoplay": "playwright test --config tests/autoplay/playwright.autoplay.config.ts",
    "simulate": "tsx scripts/simulate.ts",
    "check:content": "tsx scripts/check-content.ts",
    "check:routes": "tsx scripts/audit-routes.ts",
    "audio:collect": "tsx scripts/collect-voice.ts",
    "audio:index": "tsx scripts/finalize-voice.ts",
    "audio:check": "tsx scripts/collect-voice.ts && tsx scripts/finalize-voice.ts --require-complete"
  },
  "dependencies": {
    "preact": "^10.27.2",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@playwright/test": "1.63.0",
    "@preact/preset-vite": "^2.10.2",
    "@types/node": "^22.18.0",
    "@types/three": "^0.180.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
